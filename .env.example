# Environment Configuration
# Copy this file to .env and update values

# Django
SECRET_KEY=change-me-to-a-random-secret-key-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
DB_NAME=testplatform
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432

# Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://redis:6379/1

# CORS
CORS_ALLOW_ALL=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000

# AI (Optional)
ENABLE_AI=false
GEMINI_API_KEY=

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Django Superuser (Configure custom credentials for first build)
SUPERUSER_EMAIL=
SUPERUSER_USERNAME=
SUPERUSER_PASSWORD=
